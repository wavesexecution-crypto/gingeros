# Dry Ginger International Sales OS — environment template
# Copy to .env.local on the production host and fill in real values.
# NEVER commit .env.local (it is git-ignored). Real secrets only live in your deploy environment.

# ---- Session signing ---------------------------------------------------------
# Long random string. Rotate only on maintenance windows (invalidates sessions).
AUTH_SECRET=replace-me-with-a-long-random-string-at-least-48-chars

# ---- Cookie hardening --------------------------------------------------------
# Set to "true" when serving over HTTPS in production.
COOKIE_SECURE=true

# ---- Waves-internal admin (NOT given to the client) --------------------------
# This is a Waves staff account for support / configuration. Never share with client.
ADMIN_EMAIL=waves-admin@waves.example
ADMIN_PASSWORD=replace-me-strong-unique

# ---- Dedicated client account (the ONLY login the client gets) --------------
# One client = one tenant. No sign-up. The client logs in with these credentials.
CLIENT_NAME=Dry Ginger International
CLIENT_EMAIL=client@gingerosales.com
CLIENT_PASSWORD=replace-me-strong-unique

# ---- AI provider -------------------------------------------------------------
# "local-evidence" is the safe default (Waves-curated, no fabrication).
# "ollama" uses a local LLM via OLLAMA_BASE_URL. Server-side only.
AI_PROVIDER=local-evidence
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_API_KEY=

# ---- Public site URL (used in emails / share links) --------------------------
NEXT_PUBLIC_APP_URL=https://dry-ginger.example.com

